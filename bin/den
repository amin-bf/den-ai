#!/usr/bin/env python3
import os
import shutil
import sys
from pathlib import Path

# den needs tomllib, so Python 3.11. Some systems put an older python3 first on PATH — macOS
# ships 3.9 ahead of anything newer — and the shebang above finds that one. Hand over to a
# newer interpreter instead of failing on the import; everything below this runs on it.
if sys.version_info < (3, 11):
    for name in ("python3.14", "python3.13", "python3.12", "python3.11"):
        found = shutil.which(name)
        if found:
            os.execv(found, [found, str(Path(__file__).resolve()), *sys.argv[1:]])
    sys.exit("den needs python 3.11 or newer (tomllib); none found on PATH")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from den.cli import main

sys.exit(main())
