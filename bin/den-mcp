#!/usr/bin/env python3
import os
import shutil
import sys
from pathlib import Path

# As in bin/den: the MCP server is started by whatever launches Claude Code, whose PATH may
# well put an older python3 first, so hand over to one new enough for tomllib.
if sys.version_info < (3, 11):
    for name in ("python3.14", "python3.13", "python3.12", "python3.11"):
        found = shutil.which(name)
        if found:
            os.execv(found, [found, str(Path(__file__).resolve()), *sys.argv[1:]])
    sys.exit("den needs python 3.11 or newer (tomllib); none found on PATH")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from den.mcp_server import main

main()
